DATABASE_URL=

# points the client at the local dev server; unset wherever a real Inngest environment is used
INNGEST_DEV=1

# the deployed replacements for INNGEST_DEV; without the signing key Inngest cannot invoke a function
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# console or ses, defaulting to console when unset
EMAIL_TRANSPORT=console

# required to send; the endpoint rate limits per api key and fails loudly without them
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# only read when EMAIL_TRANSPORT=ses
SES_SENDER_REGION=
SES_SENDER_ACCESS_KEY_ID=
SES_SENDER_SECRET_ACCESS_KEY=

# both from terraform output in infra/; without the first SES reports nothing back,
# and without the second /sns/ses rejects every notification
SES_CONFIGURATION_SET=
SES_EVENTS_TOPIC_ARN=
