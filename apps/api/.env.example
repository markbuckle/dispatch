DATABASE_URL=

# points the client at the local dev server; unset wherever a real Inngest environment is used
INNGEST_DEV=1

# console or ses, defaulting to console when unset
EMAIL_TRANSPORT=console

# only read when EMAIL_TRANSPORT=ses
SES_SENDER_REGION=
SES_SENDER_ACCESS_KEY_ID=
SES_SENDER_SECRET_ACCESS_KEY=
