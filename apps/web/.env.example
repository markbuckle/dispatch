NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# deleting an account needs the admin api; never prefix this one NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# replaying a webhook delivery sends an Inngest event from here, so this app needs the same pointer as the api
INNGEST_DEV=1

# the deployed replacement for INNGEST_DEV; set one or the other, never both
INNGEST_EVENT_KEY=

# domain identity management, separate from the api's sending credentials
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# all three or no client is built, and every flag then resolves off, hiding whatever it gates
POSTHOG_PROJECT_API_KEY=
POSTHOG_SECRET_API_KEY=
POSTHOG_HOST=

# pins a flag without asking PostHog; local only, and a deployed environment must never carry it
POSTHOG_FLAG_OVERRIDES=
