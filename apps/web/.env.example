INNGEST_DEV=1

# domain identity management
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# sending
SES_SENDER_REGION=
SES_SENDER_ACCESS_KEY_ID=
SES_SENDER_SECRET_ACCESS_KEY=
