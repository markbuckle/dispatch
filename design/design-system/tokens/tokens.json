  "elevation": {
    "none": {
      "$value": "none"
    },
    "ring": {
      "$value": "inset 0 0 0 1px rgba(255,255,255,0.03)"
    },
    "overlay": {
      "$value": "0 8px 24px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.06)",
      "$description": "Dropdowns, dialogs, toasts. The only permitted drop shadow."
    },
    "focus": {
      "$value": "0 0 0 2px var(--dispatch-canvas), 0 0 0 4px #0090FF"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms",
      "$description": "Hover, colour, border, focus"
    },
    "overlay": {
      "$value": "200ms",
      "$description": "Dropdowns, dialogs, Radix transitions"
    },
    "slow": {
      "$value": "300ms",
      "$description": "Sheets and full-panel reveals only"
    }
  },
  "easing": {
    "out": {
      "$value": "cubic-bezier(0,0,0.2,1)"
    },
    "standard": {
      "$value": "cubic-bezier(0.4,0,0.2,1)"
    }
