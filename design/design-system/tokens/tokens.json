{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Dispatch design tokens. Dark is the default theme and is MEASURED from the authenticated product in dark mode. See PROVENANCE.md.",
  "color": {
    "$type": "color",
    "canvas": {
      "$value": "#08080A",
      "$description": "Page floor and sidebar"
    },
    "surface": {
      "$value": "#0E0E10",
      "$description": "Cards, panels"
    },
    "subtle": {
      "$value": "#131315",
      "$description": "Table headers, leading tiles"
    },
    "hover": {
      "$value": "#16161A",
      "$description": "Hover and active nav"
    },
    "border": {
      "subtle": {
        "$value": "#1F2023",
        "$description": "Cards, tables, row dividers"
      },
      "default": {
        "$value": "#26262A",
        "$description": "Inputs, buttons, chips"
      },
      "hover": {
        "$value": "#3D3D43",
        "$description": "Hovered control edge"
      }
    },
    "text": {
      "primary": {
        "$value": "#EDEEF0",
        "$description": "Headings and values. Off-white, never #FFF."
      },
      "secondary": {
        "$value": "#B0B4BA",
        "$description": "Body copy"
      },
      "tertiary": {
        "$value": "#9A9DA3",
        "$description": "Table headers, inactive nav"
      },
      "muted": {
