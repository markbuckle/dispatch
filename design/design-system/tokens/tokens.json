  "fontFamily": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Geist",
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "sans": {
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "Commit Mono",
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
