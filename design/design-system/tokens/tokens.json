      "placeholder": {
        "$value": "#696E77",
        "$description": "Placeholders, line numbers. Non-text use only."
      },
      "inverse": {
        "$value": "#08080A"
      }
    },
    "accent": {
      "$value": "#0090FF",
      "$description": "Focus rings and the info state ONLY. Not a brand colour."
    },
    "success": {
